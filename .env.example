# 先用 mock 运行，不会调用外部模型。
# 配置下方模型参数后，把 mode 改成 openai，再重启 PayLens。
PAYLENS_AI_MODE=mock
PAYLENS_AI_BASE_URL=https://api.openai.com/v1
PAYLENS_AI_MODEL=
PAYLENS_AI_API_KEY=
PAYLENS_AI_CONNECT_TIMEOUT_SECONDS=5
PAYLENS_AI_REQUEST_TIMEOUT_SECONDS=30

# 本地 BGE 文件由 scripts/prepare-bge-model.ps1 显式生成；缺文件时自动退化为规则归并。
PAYLENS_EMBEDDING_ENABLED=true
PAYLENS_EMBEDDING_MODEL_DIR=models/bge-small-zh-v1.5
PAYLENS_INCIDENTS_ENABLED=true
PAYLENS_INCIDENT_SEMANTIC_AUTO_MERGE=false
PAYLENS_INCIDENT_CALIBRATION_ID=
PAYLENS_INCIDENT_GROUPING_THRESHOLD=0.90

# 可选：仅当上游种子商户/应用标识发生变化时填写。
# PAYLENS_DEMO_MCH_NO=
# PAYLENS_DEMO_APP_ID=
